  "poems": [
    {
      "id": "jingyesi",
      "title": "静夜思",
      "author": "李白",
      "dynasty": "唐",
      "grade": 1,
      "book": "下",
      "lines": ["床前明月光，", "疑是地上霜。", "举头望明月，", "低头思故乡。"]
    },
    {
      "id": "chishang",
      "title": "池上",
      "author": "白居易",
      "dynasty": "唐",
      "grade": 1,
      "book": "下",
      "lines": ["小娃撑小艇，", "偷采白莲回。", "不解藏踪迹，", "浮萍一道开。"]
    },
    {
      "id": "xiaochi",
      "title": "小池",
      "author": "杨万里",
      "dynasty": "宋",
      "grade": 1,
      "book": "下",
      "lines": ["泉眼无声惜细流，", "树阴照水爱晴柔。", "小荷才露尖尖角，", "早有蜻蜓立上头。"]
    },
    {
      "id": "dengguan",
      "title": "登鹳雀楼",
      "author": "王之涣",
      "dynasty": "唐",
      "grade": 2,
      "book": "上",
      "lines": ["白日依山尽，", "黄河入海流。", "欲穷千里目，", "更上一层楼。"]
    },
    {
      "id": "wanglu",
      "title": "望庐山瀑布",
      "author": "李白",
      "dynasty": "唐",
      "grade": 2,
      "book": "上",
      "lines": ["日照香炉生紫烟，", "遥看瀑布挂前川。", "飞流直下三千尺，", "疑是银河落九天。"]
    },
    {
      "id": "jiangxue",
      "title": "江雪",
      "author": "柳宗元",
      "dynasty": "唐",
      "grade": 2,
      "book": "上",
      "lines": ["千山鸟飞绝，", "万径人踪灭。", "孤舟蓑笠翁，", "独钓寒江雪。"]
    },
    {
      "id": "chilege",
      "title": "敕勒歌",
      "author": "北朝民歌",
      "dynasty": "北朝",
      "grade": 2,
      "book": "上",
      "lines": ["敕勒川，阴山下。", "天似穹庐，笼盖四野。", "天苍苍，野茫茫，", "风吹草低见牛羊。"]
    },
    {
      "id": "yongliu",
      "title": "咏柳",
      "author": "贺知章",
      "dynasty": "唐",
      "grade": 2,
      "book": "下",
      "lines": ["碧玉妆成一树高，", "万条垂下绿丝绦。", "不知细叶谁裁出，", "二月春风似剪刀。"]
    },
    {
      "id": "cunju",
      "title": "村居",
      "author": "高鼎",
      "dynasty": "清",
      "grade": 2,
      "book": "下",
      "lines": ["草长莺飞二月天，", "拂堤杨柳醉春烟。", "儿童散学归来早，", "忙趁东风放纸鸢。"]
    },
    {
      "id": "jueju-huangli",
      "title": "绝句",
      "subtitle": "两个黄鹂鸣翠柳",
      "author": "杜甫",
      "dynasty": "唐",
      "grade": 2,
      "book": "下",
      "lines": ["两个黄鹂鸣翠柳，", "一行白鹭上青天。", "窗含西岭千秋雪，", "门泊东吴万里船。"]
    },
    {
      "id": "xiaochu",
      "title": "晓出净慈寺送林子方",
      "author": "杨万里",
      "dynasty": "宋",
      "grade": 2,
      "book": "下",
      "lines": ["毕竟西湖六月中，", "风光不与四时同。", "接天莲叶无穷碧，", "映日荷花别样红。"]
    },
    {
      "id": "jueju-chiri",
      "title": "绝句",
      "subtitle": "迟日江山丽",
      "author": "杜甫",
      "dynasty": "唐",
      "grade": 3,
      "book": "下",
      "lines": ["迟日江山丽，", "春风花草香。", "泥融飞燕子，", "沙暖睡鸳鸯。"]
    },
    {
      "id": "huichong",
      "title": "惠崇春江晚景",
      "author": "苏轼",
      "dynasty": "宋",
      "grade": 3,
      "book": "下",
      "lines": ["竹外桃花三两枝，", "春江水暖鸭先知。", "蒌蒿满地芦芽短，", "正是河豚欲上时。"]
    },
    {
      "id": "sanqu",
      "title": "三衢道中",
      "author": "曾几",
      "dynasty": "宋",
      "grade": 3,
      "book": "下",
      "lines": ["梅子黄时日日晴，", "小溪泛尽却山行。", "绿阴不减来时路，", "添得黄鹂四五声。"]
    },
    {
      "id": "yuanri",
      "title": "元日",
      "author": "王安石",
      "dynasty": "宋",
      "grade": 3,
      "book": "下",
      "lines": ["爆竹声中一岁除，", "春风送暖入屠苏。", "千门万户曈曈日，", "总把新桃换旧符。"]
    },
    {
      "id": "qingming",
      "title": "清明",
      "author": "杜牧",
      "dynasty": "唐",
      "grade": 3,
      "book": "下",
      "lines": ["清明时节雨纷纷，", "路上行人欲断魂。", "借问酒家何处有？", "牧童遥指杏花村。"]
    },
    {
      "id": "jiuyue",
      "title": "九月九日忆山东兄弟",
      "author": "王维",
      "dynasty": "唐",
      "grade": 3,
      "book": "下",
      "lines": ["独在异乡为异客，", "每逢佳节倍思亲。", "遥知兄弟登高处，", "遍插茱萸少一人。"]
    },
    {
      "id": "mujiang",
      "title": "暮江吟",
      "author": "白居易",
      "dynasty": "唐",
      "grade": 4,
      "book": "上",
      "lines": ["一道残阳铺水中，", "半江瑟瑟半江红。", "可怜九月初三夜，", "露似真珠月似弓。"]
    },
    {
      "id": "tixilin",
      "title": "题西林壁",
      "author": "苏轼",
      "dynasty": "宋",
      "grade": 4,
      "book": "上",
      "lines": ["横看成岭侧成峰，", "远近高低各不同。", "不识庐山真面目，", "只缘身在此山中。"]
    },
    {
      "id": "xuemei",
      "title": "雪梅",
      "author": "卢钺",
      "dynasty": "宋",
      "grade": 4,
      "book": "上",
      "lines": ["梅雪争春未肯降，", "骚人阁笔费评章。", "梅须逊雪三分白，", "雪却输梅一段香。"]
    },
    {
      "id": "liangzhou",
      "title": "凉州词",
      "subtitle": "葡萄美酒夜光杯",
      "author": "王翰",
      "dynasty": "唐",
      "grade": 4,
      "book": "上",
      "lines": ["葡萄美酒夜光杯，", "欲饮琵琶马上催。", "醉卧沙场君莫笑，", "古来征战几人回？"]
    },
    {
      "id": "chusai",
      "title": "出塞",
      "author": "王昌龄",
      "dynasty": "唐",
      "grade": 4,
      "book": "上",
      "lines": ["秦时明月汉时关，", "万里长征人未还。", "但使龙城飞将在，", "不教胡马度阴山。"]
    },
    {
      "id": "xiari",
      "title": "夏日绝句",
      "author": "李清照",
      "dynasty": "宋",
      "grade": 4,
      "book": "上",
      "lines": ["生当作人杰，", "死亦为鬼雄。", "至今思项羽，", "不肯过江东。"]
    },
    {
      "id": "shier",
      "title": "示儿",
      "author": "陆游",
      "dynasty": "宋",
      "grade": 5,
      "book": "上",
      "lines": ["死去元知万事空，", "但悲不见九州同。", "王师北定中原日，", "家祭无忘告乃翁。"]
    },
    {
      "id": "linan",
      "title": "题临安邸",
      "author": "林升",
      "dynasty": "宋",
      "grade": 5,
      "book": "上",
      "lines": ["山外青山楼外楼，", "西湖歌舞几时休？", "暖风熏得游人醉，", "直把杭州作汴州。"]
    },
    {
      "id": "jihai",
      "title": "己亥杂诗",
      "subtitle": "九州生气恃风雷",
      "author": "龚自珍",
      "dynasty": "清",
      "grade": 5,
      "book": "上",
      "lines": ["九州生气恃风雷，", "万马齐喑究可哀。", "我劝天公重抖擞，", "不拘一格降人材。"]
    },
    {
      "id": "shanjum",
      "title": "山居秋暝",
      "author": "王维",
      "dynasty": "唐",
      "grade": 5,
      "book": "上",
      "lines": ["空山新雨后，", "天气晚来秋。", "明月松间照，", "清泉石上流。", "竹喧归浣女，", "莲动下渔舟。", "随意春芳歇，", "王孙自可留。"]
    },
    {
      "id": "fengqiao",
      "title": "枫桥夜泊",
      "author": "张继",
      "dynasty": "唐",
      "grade": 5,
      "book": "上",
      "lines": ["月落乌啼霜满天，", "江枫渔火对愁眠。", "姑苏城外寒山寺，", "夜半钟声到客船。"]
    },
    {
      "id": "zaochun",
      "title": "早春呈水部张十八员外",
      "subtitle": "其一",
      "author": "韩愈",
      "dynasty": "唐",
      "grade": 5,
      "book": "上",
      "lines": ["天街小雨润如酥，", "草色遥看近却无。", "最是一年春好处，", "绝胜烟柳满皇都。"]
    }
  ]
}
